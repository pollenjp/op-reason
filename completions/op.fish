# fish completion for __OPREASON_CMD__, the op-reason wrapper of the 1Password CLI (generated by
# `op-reason --completion fish [<command>]`).
#
# Install it as ~/.config/fish/completions/op.fish (for the op symlink) and, with `op-reason` as the command, as
# op-reason.fish. fish reads the first op.fish on fish_complete_path and falls back to the op.fish it ships only when
# there is none. The shipped one runs `op completion fish` the first time a completion is needed, which the wrapper
# refuses without a reason (and logs as refused); the real op's completion also runs `op __complete` for every
# candidate, which through the wrapper would start powershell.exe and op.exe and could show approval prompts.
#
# This completion never runs op. It offers --reason, op's commands two levels deep, global flags and the flags of common
# commands. Values that only op knows (item and vault names) are not offered. After -- (the child command of op run) the
# child command's own completion is used.
#
# The lists were copied from `op __complete` of op 2.41.0. When op adds or changes commands or flags, copy them again
# (run a Linux op with HOME set to an empty temporary directory, so that no settings are touched):
#
#   HOME=$(mktemp -d) op __complete ""            # top-level commands
#   HOME=$(mktemp -d) op __complete item ""       # second level
#   HOME=$(mktemp -d) op __complete item get -    # flags (- shows the short forms too; -- only the long ones)

# --- Reading the command line

# __op_reason_words: the words after the command (up to the word under the cursor) without flags and their values (the
# command path), one per line. Stops at -- and prints it (what follows is the child command of op run and the like).
# Skips the value of flags that take one separated by a space (so that the reason of --reason "<reason>" is not read as a
# command); keep the list in step with the flags marked -r or -x below (short forms too). fish's echo reads -- as the end
# of options and prints an empty line, so printf is used
function __op_reason_words
    set -l skip 0
    for w in (commandline -xpc)[2..]
        if test $skip = 1
            set skip 0
            continue
        end
        switch $w
            case --
                printf '%s\n' --
                return
            case --reason --account --config --encoding --format --session --vault --fields --categories --tags \
                --category --title --url --template --out-file --in-file --file-mode --env-file --environment --file-name \
                -o -i
                set skip 1
            case '-*'
            case '*'
                printf '%s\n' $w
        end
    end
end

# __op_reason_at <word>...: the command path is exactly <word>... (with no words: no command yet)
function __op_reason_at
    test "$(__op_reason_words | string join ' ')" = "$argv"
end

# __op_reason_in <word>...: the command path starts with <word>... and there is no -- yet
function __op_reason_in
    set -l words (__op_reason_words)
    set -l n (count $argv)
    not contains -- -- $words
    and test (count $words) -ge $n
    and test "$words[1..$n]" = "$argv"
end

# __op_reason_opts: op's flags may be offered (no -- yet)
function __op_reason_opts
    not contains -- -- (commandline -xpc)
end

# __op_reason_no_reason: --reason is not written yet (the wrapper reads only the first one before --; a second one goes
# to op). Also true while the value of --reason is being written (the previous word is --reason): fish reads the current
# word as the value of --reason, and offers no commands, only when a -l reason line with a passing condition exists
function __op_reason_no_reason
    set -l tokens (commandline -xpc)[2..]
    test "$tokens[-1]" = --reason; and return 0
    for w in $tokens
        switch $w
            case --
                break
            case --reason '--reason=*'
                return 1
        end
    end
    return 0
end

# __op_reason_child: after -- (the child command of op run and op plugin run), use that command's own completion
function __op_reason_child
    set -l tokens (commandline -xpc)
    set -l i (contains -i -- -- $tokens)
    complete -C (string join ' ' -- (string escape -- $tokens[(math $i + 1)..]) (commandline -ct))
end

# Most of op's arguments are not files, so files are added per flag with -F
complete -c __OPREASON_CMD__ -f

# --- The wrapper's flag. Offered for op <Tab> too, so that it is clear that it is needed

complete -c __OPREASON_CMD__ -n '__op_reason_opts; and __op_reason_no_reason' -l reason -x -d 'Why you call op (op-reason, required: what for, what you read or write)'
complete -c __OPREASON_CMD__ -n '__op_reason_at; and __op_reason_no_reason' -a --reason -d 'Why you call op (op-reason, required: what for, what you read or write)'

# Wrapper options: only as the first argument (nothing typed after the command yet)
